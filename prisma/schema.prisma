// Схема базы данных yourway.uz. Пишется под PostgreSQL (Neon).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Анонимная сессия прохождения тестов. Её id хранится в cookie браузера.
model TestSession {
  id             String         @id @default(uuid())
  // Аккаунт, к которому привязана сессия. Пусто, пока человек не зарегистрировался или не вошёл
  // (тесты проходятся анонимно). Привязанную сессию видит только владелец аккаунта.
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Выбор на экране-развилке: knows_goal (знаю цель) или no_goal (не знаю, хочу разобраться).
  pathType       String
  // Язык интерфейса в момент начала (для аналитики; тексты вопросов показываются на текущем языке).
  locale         String
  // in_progress — идут тесты; tests_done — все 4 теста пройдены и баллы посчитаны;
  // survey_done — опрос пройден и профиль (Приложение А §9) собран.
  status         String         @default("in_progress")
  // Посчитанные баллы (см. src/lib/assessment/scoring.ts, тип Scores). Пусто, пока тесты не пройдены.
  scores         Json?
  // Итоговый профиль для промптов ИИ (см. src/lib/assessment/profile.ts, тип Profile). Пусто, пока опрос не пройден.
  profile        Json?
  answers        TestAnswer[]
  surveyAnswers  SurveyAnswer[]
  teasers        Teaser[]
  aiCalls        AiCall[]
  payments       Payment[]
  reports        Report[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  testsDoneAt    DateTime?
  profileDoneAt  DateTime?

  @@index([userId, createdAt])
}

// Один ответ на один вопрос теста. Пишется в базу сразу после нажатия кнопки.
model TestAnswer {
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // big_five | riasec | values | perception
  test       String
  // Номер вопроса из data/tests/*.json
  questionId Int
  // Ответ по шкале 1–5
  value      Int
  updatedAt  DateTime    @updatedAt

  @@id([sessionId, test, questionId])
}

// Один ответ на один вопрос контекстного опроса (data/tests/context_survey.json).
model SurveyAnswer {
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Id вопроса из context_survey.json (например "age", "goal_text")
  questionId String
  // Значение: число, строка или список строк — в зависимости от типа вопроса.
  // Пустая строка "" у необязательного вопроса означает «пропущено».
  value      Json
  updatedAt  DateTime    @updatedAt

  @@id([sessionId, questionId])
}

// Бесплатный ИИ-тизер (Приложение Б §4). Не больше одного на язык в сессии:
// первый — по лимиту TEASER_LIMIT_PER_SESSION, второй (на другом языке) — по TEASER_LANG_REGEN_PER_SESSION.
model Teaser {
  id            String      @id @default(uuid())
  sessionId     String
  session       TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Язык, на котором тизер сгенерирован (uz | ru). Тизер остаётся на этом языке (решение (Л)).
  locale        String
  // Уровень, с которым генерировался тизер (route | navigator), по умолчанию от развилки (решение (В)).
  level         String
  // generating — идёт генерация; ready — готов; failed — не удалось после повторов (можно попробовать ещё раз).
  status        String      @default("generating")
  // JSON ответа ИИ по схеме Приложения Б §4 (включая surprise_direction_internal — пользователю не показывается).
  content       Json?
  // mock — тестовый режим ИИ; live — настоящий Claude.
  aiMode        String
  model         String
  promptVersion String
  // Сколько раз вызывали ИИ для этого тизера (включая повторы после неудачной проверки ответа).
  attempts      Int         @default(0)
  // Короткий технический код ошибки (для разработчика), если status = failed.
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  aiCalls       AiCall[]

  @@unique([sessionId, locale])
}

// Журнал каждого обращения к ИИ: модель, токены, примерная стоимость (для себестоимости в админке, этап 8).
model AiCall {
  id               String       @id @default(uuid())
  // teaser | report
  kind             String
  sessionId        String?
  session          TestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  teaserId         String?
  teaser           Teaser?      @relation(fields: [teaserId], references: [id], onDelete: SetNull)
  reportId         String?
  report           Report?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  // Часть полного отчёта (portrait_goal | main_path | finish), для тизера пусто.
  part             String?
  // Хеш IP-адреса: по первым попыткам (attempt = 1) считается мягкий лимит тизеров с одного IP в сутки.
  ipHash           String?
  aiMode           String
  model            String
  promptVersion    String
  // Номер попытки (1 — первая, 2 — повтор после неудачной проверки ответа).
  attempt          Int
  // Ответ ИИ прошёл проверку схемой и правилами.
  ok               Boolean
  error            String?
  // Язык генерации (uz | ru) — для /dev/ai-log и сравнения скорости по языкам.
  locale           String?
  // Все проблемы, найденные проверкой ответа (список строк), — пусто, если ответ принят.
  problems         Json?
  // Сырой текст ответа ИИ (для разбора брака в /dev/ai-log). Обрезается до 20 000 символов.
  responseText     String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  // Примерная стоимость в долларах США по прайсу из src/lib/ai/config.ts. Пусто, если цена модели неизвестна.
  costUsd          Float?
  durationMs       Int
  createdAt        DateTime     @default(now())

  @@index([kind, createdAt])
  @@index([ipHash, createdAt])
  @@index([reportId])
}

// Аккаунт пользователя (этап 5). Только логин и пароль: ФИО, телефон и e-mail не собираются.
model User {
  id               String        @id @default(uuid())
  // Логин в нижнем регистре (латиница, цифры, «_», «.», «-»). Регистр при входе не важен.
  login            String        @unique
  // Хеш пароля (argon2id). Сам пароль нигде не хранится.
  passwordHash     String
  // Хеш кода восстановления (argon2id). Код показывается один раз при регистрации (и при каждом
  // восстановлении — новый). После использования старый код перестаёт работать.
  recoveryCodeHash String
  // Язык интерфейса при регистрации (uz | ru).
  locale           String
  // user | admin | superadmin (этап 8, см. src/lib/admin). Суперадмином можно быть и без этой
  // записи — по логину из переменной окружения SUPERADMIN_LOGINS (см. .env.example).
  role             String        @default("user")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  testSessions     TestSession[]
  authSessions     AuthSession[]
  payments         Payment[]
  reports          Report[]
}

// Вход в аккаунт на одном устройстве. В cookie браузера лежит случайный токен, здесь — только его хеш.
model AuthSession {
  id        String   @id @default(uuid())
  // SHA-256 от токена из cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Журнал попыток входа, восстановления и регистрации — для защиты от перебора паролей.
// Хранится только логин (как ввели, в нижнем регистре) и хеш IP-адреса.
model AuthAttempt {
  id        String   @id @default(uuid())
  // login | recover | register
  kind      String
  login     String?
  ipHash    String?
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([ipHash, createdAt])
}

// Цена уровня полного отчёта (этап 6). Цены хранятся в базе, а не в коде: поменять цену можно
// без программиста — в админке (/admin/prices, этап 8).
model Price {
  // route («Маршрут») | navigator («Навигатор»)
  level     String   @id
  // Цена в сумах, целое число.
  amount    Int
  updatedAt DateTime @updatedAt
}

// Промокод на скидку (этап 6). Управление — в админке (/admin/promo, этап 8).
model PromoCode {
  id         String    @id @default(uuid())
  // Код в верхнем регистре (регистр при вводе не важен).
  code       String    @unique
  // Скидка в процентах, 1–100. 100 — отчёт бесплатно.
  percentOff Int
  active     Boolean   @default(true)
  // Сколько раз код можно использовать (пусто — без ограничения) и сколько уже использовали.
  maxUses    Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  // Тестовый код: работает только там, где включена тестовая оплата, и никогда на боевом сайте.
  testOnly   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  payments   Payment[]
}

// Оплата полного отчёта. Данные карт у нас НЕ хранятся (их обрабатывает платёжный шлюз):
// только id транзакции, сумма и статус (CLAUDE.md §8).
model Payment {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Уровень отчёта: route | navigator.
  level         String
  // Язык интерфейса в момент оплаты: на нём пишется полный отчёт (решение (Л)).
  locale        String
  // Цена уровня без скидки и сумма к оплате (после промокода), в сумах.
  baseAmount    Int
  amount        Int
  currency      String      @default("UZS")
  promoCodeId   String?
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  // test — тестовая оплата (только вне боевого сайта); promo — промокод на 100 %;
  // позже: payme | click | uzum.
  provider      String
  // Id транзакции у платёжного шлюза.
  providerTxnId String?
  // pending — ждём оплату; paid — оплачено; cancelled — отменено; failed — отказ шлюза.
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  report        Report?

  @@index([userId, createdAt])
}

// Версия промпта (этап 8б). Ключ — та же разбивка, что у ModelOverride, плюс уровень для отчёта:
// "teaser_ru", "teaser_uz", "report_route_ru", "report_route_uz", "report_navigator_ru", "report_navigator_uz".
// Версии не удаляются: история видна в /admin/prompts, откат — назначением activeAt заново.
// Версия 1 на каждый ключ создаётся автоматически из текста в коде (src/lib/ai/prompts.ts) при первом
// обращении — см. ensurePromptSeed в src/lib/ai/prompt-store.ts.
model PromptVersion {
  id             String    @id @default(uuid())
  key            String
  version        Int
  systemTemplate String
  userTemplate   String
  // Короткий комментарий «что поменял» (пусто у версии 1 — она пришла из кода).
  comment        String?
  // Активна ли эта версия сейчас (используется при генерации). Ровно одна активная версия на ключ —
  // это гарантирует код (src/lib/ai/prompt-store.ts), а не ограничение базы.
  active         Boolean   @default(false)
  createdBy      String?
  createdAt      DateTime  @default(now())
  // Кто и когда последний раз сделал эту версию активной (при сохранении новой версии «сразу
  // активной» совпадает с createdBy/createdAt; при откате на старую версию — отдельная запись).
  activatedBy    String?
  activatedAt    DateTime?

  @@unique([key, version])
  @@index([key, active])
}

// Ручной выбор модели ИИ для тизера/отчёта из админки (этап 8). Ключ — "teaser_ru", "teaser_uz",
// "report_route" или "report_navigator". Строки без записи здесь используют значение по умолчанию
// из переменных окружения (src/lib/ai/config.ts) — админка только переопределяет его сверху.
model ModelOverride {
  key       String   @id
  model     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Событие воронки для аналитики (этап 8), для шагов, которых нет готовой строкой в других таблицах:
// заход на сайт и скачивание PDF. Остальные шаги воронки (старт теста, конец теста, тизер,
// регистрация, оплата) считаются напрямую по TestSession/Teaser/User/Payment — так короче и без дублей.
model FunnelEvent {
  id        String   @id @default(uuid())
  // visit | pdf
  event     String
  locale    String
  sessionId String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

// Полный платный отчёт (Приложение Б §5, §7). Генерируется в фоне по частям (см. src/lib/report):
// каждая часть — отдельный вызов ИИ и отдельный запрос к серверу, чтобы ни один запрос не упёрся
// в лимит времени хостинга. Оплаченный доступ не теряется: при сбое отчёт можно сгенерировать заново.
model Report {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  paymentId     String      @unique
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // route | navigator — выбранный при оплате уровень.
  level         String
  // Язык отчёта (uz | ru) = язык интерфейса в момент оплаты.
  locale        String
  // knows_goal | no_goal — развилка.
  pathType      String
  // pending — оплачен, генерация ещё не началась; generating — идёт; ready — готов;
  // failed — не удалось после повтора (кнопка «Сгенерировать заново», без повторной оплаты).
  status        String      @default("pending")
  // Профиль (Приложение А §9) на момент оплаты, с выбранным уровнем, и JSON тизера (вход Вызова 2).
  profile       Json
  teaser        Json
  // Готовые части отчёта: { "portrait_goal": {...}, "main_path": {...}, ... }.
  parts         Json        @default("{}")
  // Собранный отчёт по схеме Приложения Б §7 (когда status = ready).
  content       Json?
  aiMode        String
  model         String
  promptVersion String
  // Попытка текущей части (0 — ещё не начинали) и данные для повтора с подсказкой:
  // { previousResponse, problems }.
  partAttempt   Int         @default(0)
  retry         Json?
  // Когда сервер взялся за очередную часть. Пусто — никто не генерирует (можно брать следующую).
  lockedAt      DateTime?
  // Сколько всего раз вызывали ИИ для этого отчёта.
  attempts      Int         @default(0)
  // Короткий технический код ошибки, если status = failed.
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  readyAt       DateTime?
  aiCalls       AiCall[]

  @@index([userId, createdAt])
  @@index([sessionId])
}

// Схема базы данных yourway.uz. Пишется под PostgreSQL (Neon).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Анонимная сессия прохождения тестов. Её id хранится в cookie браузера.
model TestSession {
  id             String         @id @default(uuid())
  // Аккаунт, к которому привязана сессия. Пусто, пока человек не зарегистрировался или не вошёл
  // (тесты проходятся анонимно). Привязанную сессию видит только владелец аккаунта.
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Выбор на экране-развилке: knows_goal (знаю цель) или no_goal (не знаю, хочу разобраться).
  pathType       String
  // Язык интерфейса в момент начала (для аналитики; тексты вопросов показываются на текущем языке).
  locale         String
  // in_progress — идут тесты; tests_done — все 4 теста пройдены и баллы посчитаны;
  // survey_done — опрос пройден и профиль (Приложение А §9) собран.
  status         String         @default("in_progress")
  // Посчитанные баллы (см. src/lib/assessment/scoring.ts, тип Scores). Пусто, пока тесты не пройдены.
  scores         Json?
  // Итоговый профиль для промптов ИИ (см. src/lib/assessment/profile.ts, тип Profile). Пусто, пока опрос не пройден.
  profile        Json?
  answers        TestAnswer[]
  surveyAnswers  SurveyAnswer[]
  teasers        Teaser[]
  aiCalls        AiCall[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  testsDoneAt    DateTime?
  profileDoneAt  DateTime?

  @@index([userId, createdAt])
}

// Один ответ на один вопрос теста. Пишется в базу сразу после нажатия кнопки.
model TestAnswer {
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // big_five | riasec | values | perception
  test       String
  // Номер вопроса из data/tests/*.json
  questionId Int
  // Ответ по шкале 1–5
  value      Int
  updatedAt  DateTime    @updatedAt

  @@id([sessionId, test, questionId])
}

// Один ответ на один вопрос контекстного опроса (data/tests/context_survey.json).
model SurveyAnswer {
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Id вопроса из context_survey.json (например "age", "goal_text")
  questionId String
  // Значение: число, строка или список строк — в зависимости от типа вопроса.
  // Пустая строка "" у необязательного вопроса означает «пропущено».
  value      Json
  updatedAt  DateTime    @updatedAt

  @@id([sessionId, questionId])
}

// Бесплатный ИИ-тизер (Приложение Б §4). Не больше одного на язык в сессии:
// первый — по лимиту TEASER_LIMIT_PER_SESSION, второй (на другом языке) — по TEASER_LANG_REGEN_PER_SESSION.
model Teaser {
  id            String      @id @default(uuid())
  sessionId     String
  session       TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Язык, на котором тизер сгенерирован (uz | ru). Тизер остаётся на этом языке (решение (Л)).
  locale        String
  // Уровень, с которым генерировался тизер (route | navigator), по умолчанию от развилки (решение (В)).
  level         String
  // generating — идёт генерация; ready — готов; failed — не удалось после повторов (можно попробовать ещё раз).
  status        String      @default("generating")
  // JSON ответа ИИ по схеме Приложения Б §4 (включая surprise_direction_internal — пользователю не показывается).
  content       Json?
  // mock — тестовый режим ИИ; live — настоящий Claude.
  aiMode        String
  model         String
  promptVersion String
  // Сколько раз вызывали ИИ для этого тизера (включая повторы после неудачной проверки ответа).
  attempts      Int         @default(0)
  // Короткий технический код ошибки (для разработчика), если status = failed.
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  aiCalls       AiCall[]

  @@unique([sessionId, locale])
}

// Журнал каждого обращения к ИИ: модель, токены, примерная стоимость (для себестоимости в админке, этап 8).
model AiCall {
  id               String       @id @default(uuid())
  // teaser (позже: report)
  kind             String
  sessionId        String?
  session          TestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  teaserId         String?
  teaser           Teaser?      @relation(fields: [teaserId], references: [id], onDelete: SetNull)
  // Хеш IP-адреса: по первым попыткам (attempt = 1) считается мягкий лимит тизеров с одного IP в сутки.
  ipHash           String?
  aiMode           String
  model            String
  promptVersion    String
  // Номер попытки (1 — первая, 2–3 — повторы после неудачной проверки ответа).
  attempt          Int
  // Ответ ИИ прошёл проверку схемой и правилами.
  ok               Boolean
  error            String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  // Примерная стоимость в долларах США по прайсу из src/lib/ai/config.ts. Пусто, если цена модели неизвестна.
  costUsd          Float?
  durationMs       Int
  createdAt        DateTime     @default(now())

  @@index([kind, createdAt])
  @@index([ipHash, createdAt])
}

// Аккаунт пользователя (этап 5). Только логин и пароль: ФИО, телефон и e-mail не собираются.
model User {
  id               String        @id @default(uuid())
  // Логин в нижнем регистре (латиница, цифры, «_», «.», «-»). Регистр при входе не важен.
  login            String        @unique
  // Хеш пароля (argon2id). Сам пароль нигде не хранится.
  passwordHash     String
  // Хеш кода восстановления (argon2id). Код показывается один раз при регистрации (и при каждом
  // восстановлении — новый). После использования старый код перестаёт работать.
  recoveryCodeHash String
  // Язык интерфейса при регистрации (uz | ru).
  locale           String
  // user (позже, на этапе 8: admin, superadmin).
  role             String        @default("user")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  testSessions     TestSession[]
  authSessions     AuthSession[]
}

// Вход в аккаунт на одном устройстве. В cookie браузера лежит случайный токен, здесь — только его хеш.
model AuthSession {
  id        String   @id @default(uuid())
  // SHA-256 от токена из cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Журнал попыток входа, восстановления и регистрации — для защиты от перебора паролей.
// Хранится только логин (как ввели, в нижнем регистре) и хеш IP-адреса.
model AuthAttempt {
  id        String   @id @default(uuid())
  // login | recover | register
  kind      String
  login     String?
  ipHash    String?
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([ipHash, createdAt])
}

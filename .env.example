# ─────────────────────────────────────────────────────────────
# Настройки yourway.uz (переменные окружения).
# Скопируйте этот файл в `.env` и заполните значения.
# Файл `.env` НЕ коммитится: в нём секреты.
# На Vercel те же переменные задаются в Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── База данных (PostgreSQL, на хостинге — Neon) ── нужно с этапа 1
# Основная строка подключения (у Neon — «pooled», адрес содержит `-pooler`).
# Её использует сайт во время работы.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yourway"
# Прямая строка подключения без пулера (у Neon — «unpooled»).
# Нужна только для миграций (создание/изменение таблиц). Если не задана, берётся DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/yourway"

# ── Язык ── нужно с этапа 1
# Язык сайта по умолчанию для нового посетителя: `uz` (узбекский, латиница) или `ru`.
DEFAULT_LOCALE="uz"

# ── ИИ (Claude API) ── нужно с этапа 4
# Ключ Claude API (platform.claude.com → API Keys). Секрет! Никогда не вставлять в код и не коммитить.
# Если пусто — сайт работает в тестовом режиме ИИ (готовые ответы-образцы, плашка «тестовый режим ИИ»).
ANTHROPIC_API_KEY=""
# Режим ИИ: `mock` — тестовые ответы (даже если ключ задан), `live` или пусто — настоящий Claude.
# Без ключа всегда используется `mock`.
AI_MODE="mock"
# Модель для бесплатного тизера на русском.
MODEL_TEASER="claude-haiku-4-5"
# Модель для бесплатного тизера на узбекском. Отдельная и более сильная: дешёвая модель пишет
# по-узбекски как дословный перевод с русского. Если пусто — claude-sonnet-5.
MODEL_TEASER_UZ="claude-sonnet-5"
# Модель для отчёта «Маршрут».
MODEL_ROUTE="claude-sonnet-5"
# Модель для отчёта «Навигатор».
MODEL_NAVIGATOR="claude-opus-5-5"

# ── Лимиты тизера ── нужно с этапа 4
# Сколько тизеров можно получить в одной сессии (одно прохождение тестов). 0 — тизеры выключены.
TEASER_LIMIT_PER_SESSION=1
# Сколько раз в сессии можно составить тизер на другом языке (кнопка «составить на … языке»).
TEASER_LANG_REGEN_PER_SESSION=1
# Мягкий лимит генераций тизера с одного IP-адреса за сутки (высокий: через один IP выходят школы
# и мобильные операторы). Сам IP не хранится, только его хеш. Повтор после сбоя тоже считается.
TEASER_LIMIT_PER_IP_PER_DAY=30

# ── Оплата ── понадобится на этапе 6
# `true` — включает тестовую оплату (без реальных денег). На боевом сайте после подключения Payme/Click/Uzum — `false`.
PAYMENTS_TEST_MODE="false"

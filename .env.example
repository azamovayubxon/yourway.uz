# ─────────────────────────────────────────────────────────────
# Настройки yourway.uz (переменные окружения).
# Скопируйте этот файл в `.env` и заполните значения.
# Файл `.env` НЕ коммитится: в нём секреты.
# На Vercel те же переменные задаются в Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Адрес сайта ── нужно с этапа 10Б
# Полный адрес сайта, с https:// и без слэша на конце (например https://yourway.uz).
# Используется как база для абсолютных ссылок (сейчас — только в метаданных страниц).
APP_URL="http://localhost:3000"

# ── База данных (PostgreSQL, на хостинге — Neon) ── нужно с этапа 1
# Основная строка подключения (у Neon — «pooled», адрес содержит `-pooler`).
# Её использует сайт во время работы.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yourway"
# Прямая строка подключения без пулера (у Neon — «unpooled»).
# Нужна только для миграций (создание/изменение таблиц). Если не задана, берётся DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/yourway"

# ── Язык ── нужно с этапа 1
# Язык сайта по умолчанию для нового посетителя: `uz` (узбекский, латиница) или `ru`.
DEFAULT_LOCALE="uz"

# ── ИИ (Claude API) ── нужно с этапа 4
# Ключ Claude API (platform.claude.com → API Keys). Секрет! Никогда не вставлять в код и не коммитить.
# Если пусто — сайт работает в тестовом режиме ИИ (готовые ответы-образцы, плашка «тестовый режим ИИ»).
ANTHROPIC_API_KEY=""
# Режим ИИ: `mock` — тестовые ответы (даже если ключ задан), `live` или пусто — настоящий Claude.
# Без ключа всегда используется `mock`.
AI_MODE="mock"
# Модель для бесплатного тизера на русском.
MODEL_TEASER="claude-haiku-4-5"
# Модель для бесплатного тизера на узбекском. Отдельная и более сильная: дешёвая модель пишет
# по-узбекски как дословный перевод с русского. Если пусто — claude-sonnet-5.
MODEL_TEASER_UZ="claude-sonnet-5"
# Модель для полного отчёта «Маршрут» (нужно с этапа 6). Если пусто — claude-sonnet-5.
MODEL_ROUTE="claude-sonnet-5"
# Модель для полного отчёта «Навигатор» (нужно с этапа 6). Если пусто — claude-opus-5-5.
MODEL_NAVIGATOR="claude-opus-5-5"

# ── Лимиты тизера ── нужно с этапа 4
# Сколько тизеров можно получить в одной сессии (одно прохождение тестов). 0 — тизеры выключены.
TEASER_LIMIT_PER_SESSION=1
# Сколько раз в сессии можно составить тизер на другом языке (кнопка «составить на … языке»).
TEASER_LANG_REGEN_PER_SESSION=1
# Мягкий лимит генераций тизера с одного IP-адреса за сутки (высокий: через один IP выходят школы
# и мобильные операторы). Сам IP не хранится, только его хеш. Повтор после сбоя тоже считается.
TEASER_LIMIT_PER_IP_PER_DAY=30

# ── Аккаунты: защита от перебора паролей ── нужно с этапа 5
# Сколько неудачных попыток входа (или восстановления по коду) в один логин подряд допускается.
# Дальше вход в этот логин временно закрывается. Удачный вход обнуляет счётчик.
AUTH_MAX_FAILURES=5
# На сколько минут закрывается вход (и за сколько минут считаются неудачные попытки).
AUTH_LOCK_MINUTES=15
# Сколько неудачных попыток с одного IP-адреса (в любые логины) за то же время допускается.
# Порог высокий: через один IP выходят школы и мобильные операторы. Сам IP не хранится, только хеш.
AUTH_MAX_FAILURES_PER_IP=50
# Сколько новых аккаунтов можно создать с одного IP-адреса за час.
AUTH_REGISTER_PER_IP_PER_HOUR=20

# ── Админка ── нужно с этапа 8
# Логины, которые всегда суперадмины (видят /admin/**, могут назначать других администраторов),
# через запятую, без пробелов. На Vercel задаётся в Settings → Environment Variables — так
# суперадмином можно стать без единого SQL-запроса. Сначала зарегистрируйте обычный аккаунт
# с таким логином на сайте, потом впишите его сюда (или переустановите переменную, если аккаунт
# уже есть) — при следующем входе он станет суперадмином. Подробности — в README.
SUPERADMIN_LOGINS=""
# Сколько раз в час можно нажать «Проверить» на странице /admin/prompts (этап 10А): эта кнопка
# запускает настоящий вызов ИИ и стоит денег, лимит защищает даже на случай угона аккаунта админа.
PROMPT_CHECK_LIMIT_PER_HOUR=30

# ── Оплата ── нужно с этапа 6
# `true` — включает тестовую оплату (без реальных денег): страница «Тестовая оплата» вместо Payme/Click/Uzum.
# На Vercel задавайте `true` ТОЛЬКО для окружения Preview. На боевом сайте (VERCEL_ENV=production,
# а вне Vercel — NODE_ENV=production) тестовая оплата не включится, даже если здесь `true`.
# Цены и промокоды хранятся в базе (таблицы Price и PromoCode), а не здесь — см. README.
PAYMENTS_TEST_MODE="false"

# ── Ошибки сервера ── нужно с этапа 10В
# Ошибки сервера всегда пишутся в базу (таблица ErrorLog), их видит владелец на /admin/errors —
# без этой переменной данные никуда за пределы своего сервера не уходят.
# Необязательно: адрес (DSN) внешнего сервиса, совместимого с Sentry — самого Sentry или
# самостоятельно установленного GlitchTip (тогда данные не покидают Узбекистан). Пусто — внешний
# сервис не используется вообще.
SENTRY_DSN=""
